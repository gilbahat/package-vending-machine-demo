opam-version: "2.0"
synopsis: "Formally verified URL gate and manifest parser for the vending machine"
description: """
Bindings to C generated by KaRaMeL (from the F* proofs in proofs/) and by
EverParse (from spec/VendManifest.3d), plus the small hand-written shim that
enforces exact-consumption on the manifest parse.

This package contains no hand-written parsing or URL logic. See the repository
README for what is proved and what is merely trusted.
"""
maintainer: "Gil Bahat <bahat.gil@gmail.com>"
authors: "Gil Bahat <bahat.gil@gmail.com>"
license: "ISC"
homepage: "https://github.com/gilbahat/package-vending-machine-demo"
bug-reports: "https://github.com/gilbahat/package-vending-machine-demo/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "2.9"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
