#!/usr/bin/env bash
#
# escape-check -- run inside the sandbox. Tries every exit this VPC is meant
# to close and reports which ones are closed. Exactly one thing should be
# reachable: the vending machine's HTTP API.
#
# Copyright (c) 2026. SPDX-License-Identifier: ISC

set -uo pipefail

# VPC_DNS (the VPC's base+2 resolver address) is written here by user-data.
# shellcheck source=/dev/null
[ -f /etc/pvm-agent.env ] && . /etc/pvm-agent.env

VEND="${VEND:-vend}"
VPC_DNS="${VPC_DNS:-}"
VEND_IP="$(getent ahostsv4 "$VEND" | awk '{print $1; exit}')"
pass=0
fail=0

check() {
  local want="$1" what="$2"; shift 2
  # Through bash -c so the probes below, which are functions, can be timed out.
  if timeout 8 bash -c '"$@"' _ "$@" >/dev/null 2>&1; then got=open; else got=closed; fi
  if [ "$got" = "$want" ]; then
    printf '  ok    %-58s %s\n' "$what" "$got"; pass=$((pass + 1))
  else
    printf '  FAIL  %-58s %s (wanted %s)\n' "$what" "$got" "$want"; fail=$((fail + 1))
  fi
}

tcp() { bash -c "exec 3<>/dev/tcp/$1/$2"; }

dns_to() {  # one raw A query for pypi.org; succeeds only on a reply
  python3 - "$1" <<'EOF'
import socket, sys
q = b"\x12\x34\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x04pypi\x03org\x00\x00\x01\x00\x01"
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(4)
s.sendto(q, (sys.argv[1], 53)); s.recv(512)
EOF
}

imds_creds() {  # succeeds only if this instance has a role to steal
  tok="$(curl -sf -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
         http://169.254.169.254/latest/api/token)" || return 1
  curl -sf -H "X-aws-ec2-metadata-token: $tok" \
    http://169.254.169.254/latest/meta-data/iam/security-credentials/ | grep -q .
}

export -f tcp dns_to imds_creds

echo "escape check from $(hostname) -- vending machine at ${VEND_IP:-?}"
echo "-------------------------------------------------------------------------------"
check open   "vending machine API (${VEND}:8080)"                     curl -sf "http://$VEND:8080/v1/status"
check closed "vending machine host, any other port (22)"               tcp "$VEND_IP" 22
check closed "pypi.org by name"                                        curl -sf https://pypi.org/simple/
check closed "files.pythonhosted.org by IP (151.101.0.223:443)"        tcp 151.101.0.223 443
check closed "arbitrary internet host (1.1.1.1:443)"                   tcp 1.1.1.1 443
check closed "public DNS resolver (1.1.1.1:53/udp)"                    dns_to 1.1.1.1
[ -n "$VPC_DNS" ] && \
check closed "Amazon VPC resolver ($VPC_DNS:53/udp)"                   dns_to "$VPC_DNS"
check closed "Route 53 link-local resolver (169.254.169.253)"          dns_to 169.254.169.253
check closed "IAM credentials via instance metadata"                   imds_creds
if sudo -n true 2>/dev/null; then
  # Try to use the vending machine host as a router. AWS's source/dest check
  # on its ENI, its security group, and its FORWARD policy each stop this.
  sudo ip route replace 1.0.0.1/32 via "$VEND_IP"
  check closed "route via the vending machine host (1.0.0.1:443)"     tcp 1.0.0.1 443
  sudo ip route del 1.0.0.1/32 via "$VEND_IP"
fi
echo "-------------------------------------------------------------------------------"
if [ "$fail" -eq 0 ]; then
  echo "PASSED: $pass checks -- the vending machine is the only way out"
else
  echo "FAILED: $fail of $((pass + fail)) checks"
fi
[ "$fail" -eq 0 ]
